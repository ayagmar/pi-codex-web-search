{
  "name": "pi-codex-web-search",
  "version": "0.2.0",
  "description": "Pi extension that exposes web search through the local Codex CLI",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "web-search"
  ],
  "license": "MIT",
  "author": "ayagmar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayagmar/pi-codex-web-search.git"
  },
  "homepage": "https://github.com/ayagmar/pi-codex-web-search#readme",
  "bugs": {
    "url": "https://github.com/ayagmar/pi-codex-web-search/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/ayagmar/pi-codex-web-search/master/docs/images/web-search-demo.png"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "node --import=tsx --test ./test/*.test.ts",
    "smoke-test": "node --import=tsx ./scripts/smoke-test.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run smoke-test",
    "release:dry": "release-it --ci --dry-run"
  },
  "dependencies": {
    "defuddle": "0.19.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-ai": "^1.0.1",
    "@earendil-works/pi-coding-agent": "^1.0.1",
    "@earendil-works/pi-tui": "^1.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.3",
    "release-it": "^21.1.0",
    "tsx": "^4.21.0",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.8.1",
  "publishConfig": {
    "access": "public"
  }
}
